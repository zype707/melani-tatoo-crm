# Copia este archivo a .env (no lo subas al repositorio) y ajusta los valores.
# Ningún valor de este archivo es real.
DJANGO_SETTINGS_MODULE=estudio.settings.dev
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DATABASE_URL=postgres://estudio:estudio@localhost:5432/estudio
TIME_ZONE=America/New_York
REGION_TELEFONO=US
MONEDA=USD
SIMBOLO_MONEDA=$
SITE_URL=http://localhost:8000
MEDIA_ROOT=./media_privado
COPIAS_ROOT=./copias
# IA (opcional: sin clave, la app funciona igual)
OPENAI_API_KEY=
IA_MODELO=gpt-6-luna
IA_LIMITE_MENSUAL=300
IA_TIMEOUT_SEGUNDOS=25
# Tareas internas (cron → web). Mínimo 32 caracteres.
TAREAS_SECRETO=
SESION_HORAS=72
